#!/usr/bin/env bash

# This script symlinks the dotfiles to the home directory on macOS
set -euo pipefail

# must be run in the current directory
cd "$(dirname "$0")"
repo="$(pwd)"

home_links=(
  ".bashrc"
  ".bash_profile"
  ".inputrc"
)

config_links=(
  "starship.toml"
  "nvim"
  "bash"
  "tmux"
  "nix"
  "alacritty"
  "direnv"
)

# special stuff for macos
macos_links=(
  "skhd"
  "yabai"
  "borders"
)

for f in "${home_links[@]}"; do
  rm -rf "$HOME/$f"
  ln -s -f "$repo/$f" "$HOME/$f"
done

mkdir -p "$HOME/.config"
for d in "${config_links[@]}"; do
  rm -rf "$HOME/.config/$d"
  ln -s -f "$repo/.config/$d" "$HOME/.config/$d"
done

for d in "${macos_links[@]}"; do
  rm -rf "$HOME/.config/$d"
  ln -s -f "$repo/macos/$d" "$HOME/.config/$d"
done
