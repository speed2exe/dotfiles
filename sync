#!/usr/bin/env bash

# This script symlinks all the dotfiles to the home directory
set -euo pipefail

# must be run in the current directory
cd "$(dirname "$0")"
repo="$(pwd)"

home_config_dirs=(
  ".config/nix"
  ".config/direnv"
  ".config/nvim"
  ".config/neofetch"
  ".config/fontconfig"
  ".config/alacritty"
  ".config/bspwm"
  ".config/polybar"
  ".config/sxhkd"
  ".config/rofi"
  ".config/picom"
  ".config/dunst"
  ".config/gtk-3.0"
  ".config/hypr"
  ".config/sway"
  ".config/waybar"
  ".config/bash"
  ".config/tmux"
  ".config/starship.toml"

  ".xinitrc"
  ".bash_profile"
  ".bashrc"
  ".inputrc"

  ".agents/skills"
)

for dir in "${home_config_dirs[@]}"; do
  rm -rf "$HOME/$dir"
  mkdir -p "$(dirname "$HOME/$dir")"
  ln -s -f "$repo/$dir" "$HOME/$dir"
done
